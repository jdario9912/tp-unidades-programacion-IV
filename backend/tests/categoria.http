@baseUrl = http://127.0.0.1:8000
@idCategoria = 15

### Listar Categorías
GET {{baseUrl}}/categorias/

### Listar Categorías por nombre
GET {{baseUrl}}/categorias/?search=coci

### Crear Categoría
POST {{baseUrl}}/categorias/
Content-Type: application/json

{
  "nombre": "cocina"
}

### Detalle de Categoría Exitoso
GET {{baseUrl}}/categorias/{{idCategoria}}

### Actualizar Categoría
PUT {{baseUrl}}/categorias/{{idCategoria}}
Content-Type: application/json

{
  "nombre": "Automaticas",
  "descripcion": "Herramientas Automaticas"
}

### Borrar Categoría
DELETE {{baseUrl}}/categorias/{{idCategoria}}
