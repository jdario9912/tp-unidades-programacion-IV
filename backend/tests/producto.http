@baseUrl = http://127.0.0.1:8000
@idProducto = 2
@idCategoria = 1

### Crear Producto
POST {{baseUrl}}/productos/
Content-Type: application/json

{
  "nombre": "Silla Ergonómica",
  "descripcion": "Silla ergonómica con soporte lumbar y ajuste de altura",
  "precio_base": 250.00,
  "imagenes_url": ["https://example.com/silla-ergonomica.jpg"],
  "disponible": true
}

### Crear Producto con nombre repetido (Prueba: 201, el nombre no es único)
POST {{baseUrl}}/productos/
Content-Type: application/json

{
  "nombre": "Silla Ergonómica",
  "descripcion": "Otra silla con el mismo nombre",
  "precio_base": 199.99,
  "imagenes_url": [],
  "disponible": true
}

### Listar Productos
GET {{baseUrl}}/productos/?skip=0&limit=5

### Listar Productos por nombre
GET {{baseUrl}}/productos/?search=silla

### Detalle Producto
GET {{baseUrl}}/productos/{{idProducto}}

### Actualizar Producto
PUT {{baseUrl}}/productos/{{idProducto}}
Content-Type: application/json

{
  "nombre": "Silla Ergonómica Super Facha",
  "descripcion": "Silla ergonómica con soporte lumbar y ajuste de altura",
  "precio_base": 300.00,
  "imagenes_url": ["https://example.com/silla-ergonomica.jpg"],
  "disponible": true
}

### Desactivar Producto
PUT {{baseUrl}}/productos/{{idProducto}}/deshabilitar

### Detalle Producto Inexistente
GET {{baseUrl}}/productos/99

### Producto Inválido
POST {{baseUrl}}/productos/
Content-Type: application/json

{
  "nombre": "Silla Ergonómica Super Facha",
  "descripcion": "Silla ergonómica con soporte lumbar y ajuste de altura",
  "precio_base": -300.00,
  "imagenes_url": [3],
  "disponible": true
}

### Borrar Producto
DELETE {{baseUrl}}/productos/{{idProducto}}

### Borrar Producto Inexistente
DELETE {{baseUrl}}/productos/99

### Asociar categoría (201)
POST {{baseUrl}}/productos/{{idProducto}}/categorias
Content-Type: application/json

{
  "categoria_id": {{idCategoria}},
  "es_principal": true
}

### Asociar categoría repetida (409)
POST {{baseUrl}}/productos/{{idProducto}}/categorias
Content-Type: application/json

{
  "categoria_id": {{idCategoria}}
}

### Asociar categoría inexistente (404)
POST {{baseUrl}}/productos/{{idProducto}}/categorias
Content-Type: application/json

{
  "categoria_id": 9876
}

### Listar categorías del producto
GET {{baseUrl}}/productos/{{idProducto}}/categorias

### Desasociar categoría (204)
DELETE {{baseUrl}}/productos/{{idProducto}}/categorias/{{idCategoria}}

### Desasociar categoría no asociada (404)
DELETE {{baseUrl}}/productos/{{idProducto}}/categorias/{{idCategoria}}
