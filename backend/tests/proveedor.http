@baseUrl = http://127.0.0.1:8000

### Crear Proveedor
POST {{baseUrl}}/proveedores/
Content-Type: application/json

{
  "codigo": "PRO-03",
  "razon_social": "Ejemplo SRL",
  "cuit": "30-12345678-9",
  "email": "",
  "telefono": "",
  "activo": true
}

### Crear Otro Proveedor
POST {{baseUrl}}/proveedores/
Content-Type: application/json

{
  "codigo": "PRO-02",
  "razon_social": "Ejemplo S.A.",
  "cuit": "30-12345678-9",
  "email": "",
  "telefono": "",
  "activo": true
}

### Crear Proveedor con datos invalidos
POST {{baseUrl}}/proveedores/
Content-Type: application/json

{
  "codigo": "PRO-03",
  "razon_social": "",
  "cuit": "30-12345678-9",
  "email": "",
  "telefono": "",
  "activo": true
}

### Listar Proveedores
GET {{baseUrl}}/proveedores/

### Detalle Proveedor
GET {{baseUrl}}/proveedores/5

### Actualizar Proveedor
PUT {{baseUrl}}/proveedores/1
Content-Type: application/json

{
  "codigo": "PRO-04",
  "razon_social": "Ejemplo S.A.",
  "cuit": "30-12345678-9",
  "email": "",
  "telefono": "",
  "activo": true
}

### Actualizar Proveedor Inexistente
PUT {{baseUrl}}/proveedores/99
Content-Type: application/json

{
  "codigo": "PRO-99",
  "razon_social": "Proveedor Inexistente",
  "cuit": "30-12345678-9",
  "email": "",
  "telefono": "",
  "activo": true
}

### Actualizar Proveedor Codigo duplicado
PUT {{baseUrl}}/proveedores/1
Content-Type: application/json

{
  "codigo": "PRO-02",
  "razon_social": "Ejemplo S.A.SO",
  "cuit": "30-12345678-9",
  "email": "",
  "telefono": "",
  "activo": true
}

### Desactivar Proveedor
PUT {{baseUrl}}/proveedores/1/desactivar  

### Desactivar Proveedor ya Inactivo (Prueba: Error 409)
PUT {{baseUrl}}/proveedores/1/desactivar
