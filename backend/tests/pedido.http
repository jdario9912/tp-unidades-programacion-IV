@baseUrl = http://127.0.0.1:8000
@idPedido = 1
@idProducto = 1

# Requiere al menos una forma de pago cargada en la tabla formapago (ej. EFECTIVO).

### Crear Pedido
POST {{baseUrl}}/pedidos/
Content-Type: application/json

{
  "forma_pago_codigo": "EFECTIVO",
  "descuento": "0.00",
  "costo_envio": "300.00",
  "notas": "Tocar timbre",
  "detalles": [
    { "producto_id": {{idProducto}}, "cantidad": 2, "personalizacion": { "quitar": ["cebolla"] } }
  ]
}

### Crear Pedido con detalles vacíos (422)
POST {{baseUrl}}/pedidos/
Content-Type: application/json

{
  "forma_pago_codigo": "EFECTIVO",
  "detalles": []
}

### Listar Pedidos
GET {{baseUrl}}/pedidos/?skip=0&limit=10

### Listar Pedidos por estado
GET {{baseUrl}}/pedidos/?estado=PENDIENTE

### Detalle Pedido
GET {{baseUrl}}/pedidos/{{idPedido}}

### Actualizar Pedido (solo PENDIENTE)
PATCH {{baseUrl}}/pedidos/{{idPedido}}
Content-Type: application/json

{
  "notas": "Dejar en portería"
}

### Cambiar estado a CONFIRMADO
PATCH {{baseUrl}}/pedidos/{{idPedido}}/estado
Content-Type: application/json

{
  "estado_codigo": "CONFIRMADO",
  "motivo": "Pago verificado"
}

### Cambiar estado inválido (409)
PATCH {{baseUrl}}/pedidos/{{idPedido}}/estado
Content-Type: application/json

{
  "estado_codigo": "PENDIENTE"
}

### Historial de estados
GET {{baseUrl}}/pedidos/{{idPedido}}/historial

### Eliminar Pedido
DELETE {{baseUrl}}/pedidos/{{idPedido}}
