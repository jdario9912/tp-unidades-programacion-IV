# Copiar a .env y completar. El .env no se sube al repositorio.

# Clave para firmar los JWT (usar una cadena larga y aleatoria)
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria

# Base de datos (docker-compose.yml también lee estos valores)
POSTGRES_USER=user
POSTGRES_PASSWORD=cambiar-contraseña
POSTGRES_DB=tienda
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Primer administrador, creado por el seed si no existe
ADMIN_EMAIL=admin@foodstore.com
ADMIN_PASSWORD=cambiar-contraseña-admin
