# Copiar a .env y completar. El .env no se sube al repositorio.

# Conexión a la base. Con docker compose: postgresql://user:pass@localhost:5432/foodstore_db
# Para desarrollo local sin Postgres: sqlite:///./foodstore.db
DATABASE_URL=postgresql://user:pass@localhost:5432/foodstore_db

# Firma del JWT: mínimo 32 caracteres, larga y aleatoria
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres

ALGORITHM=HS256

# Expiración de la cookie y del token, en minutos
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend permitido en CORS
FRONTEND_ORIGIN=http://localhost:5173

# Admin que crea el seed si no existe (el username siempre es admin)
ADMIN_EMAIL=admin@foodstore.com
ADMIN_PASSWORD=Admin1234!
